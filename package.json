{
  "name": "fjst-workspace",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ro80t/fjst.git"
  },
  "workspaces": {
    "packages": [
      "packages/**",
      "tests/**"
    ],
    "catalog": {
      "@sveltejs/kit": "^2.55.0",
      "@types/bun": "latest",
      "oxfmt": "^0.61.0",
      "oxlint": "^1.58.0",
      "tsdown": "^0.22.14"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "lint:root": "oxlint -c oxlint.config.ts . && oxfmt -c oxfmt.config.ts --check .",
    "lint:fix:root": "oxlint -c oxlint.config.ts . --fix",
    "format:root": "oxfmt -c oxfmt.config.ts ."
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "^2.10.7"
  },
  "peerDependencies": {
    "typescript": "6"
  },
  "packageManager": "bun@1.3.3",
  "dependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
