{
  "name": "@fjst/sveltekit",
  "version": "0.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ro80t/fjst.git",
    "directory": "packages/sveltekit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    },
    "./mini": {
      "import": "./dist/mini/index.mjs",
      "require": "./dist/mini/index.cjs",
      "types": "./dist/mini/index.d.mts"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "package.tgz",
    "provenance": true
  },
  "scripts": {
    "pack": "bun ../../scripts/pack-tarball.ts"
  },
  "dependencies": {
    "@sveltejs/kit": "catalog:"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:"
  }
}
